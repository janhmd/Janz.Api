{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  // Fayla loglama: hər gün logs/janz-YYYYMMDD.log, Warning və yuxarılar logs/errors-YYYYMMDD.log-a da düşür
  "FileLogging": {
    "Path": "logs",
    "RetainDays": 14,
    "SeparateErrorFile": true
  },
  // Çatdırılma haqqı (₼) və bu məbləğdən (endirimdən sonra) yuxarı pulsuz çatdırılma. Çatdırılmada ödəniş yalnız Bakıda
  "Delivery": {
    "Fee": 3.00,
    "FreeFrom": 50.00
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=JanzDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Key": "JanzShopJwtKey-ChangeThisTo32CharsMin!",
    "Issuer": "Janz.Api",
    "Audience": "Janz.Mvc",
    "ExpireDays": 7
  },
  // İşçi hesabları başlanğıcda yaradılır. Lokal SuperAdmin appsettings.Development.json-dadır
  "SeedAdmins": [],
  // SMTP (Gmail: smtp.gmail.com, 587). User və Password user-secrets-də saxlanılır, boş olanda məktub loga yazılır
  "Email": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "User": "",
    "Password": "",
    "From": "",
    "FromName": "Janz"
  },
  "Stripe": {
    "SecretKey": "",
    "Currency": "azn"
  },
  // Sayt köməkçisi: Google AI Studio-dan pulsuz açar. ApiKey user-secrets-də saxlanılır, boş olanda köməkçi hazır cavablarla işləyir
  "Gemini": {
    "ApiKey": "",
    "Model": "gemini-flash-lite-latest"
  },
  "Frontend": {
    "MvcBaseUrl": "https://localhost:7047",
    "MvcOrigins": [
      "http://localhost:5072",
      "https://localhost:7047"
    ]
  }
}
